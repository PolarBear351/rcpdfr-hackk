-- ServerScriptService: SpawnCarScript

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CarsFolder = ReplicatedStorage:WaitForChild("Cars")

local RemoteEvent = Instance.new("RemoteEvent")
RemoteEvent.Name = "SpawnCarEvent"
RemoteEvent.Parent = ReplicatedStorage

RemoteEvent.OnServerEvent:Connect(function(player, carName)
    local carModel = CarsFolder:FindFirstChild(carName)
    if not carModel then
        warn("Car not found: " .. carName)
        return
    end

    local carClone = carModel:Clone()
    carClone.Parent = workspace

    -- Spawn in front of the player
    local char = player.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local hrp = char.HumanoidRootPart
        carClone:SetPrimaryPartCFrame(
            hrp.CFrame * CFrame.new(0, 0, -10)
        )
    end
end)
